# --- Telegram ---
# Token du bot : @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=
# Chat ID autorisé : le bot n'accepte que ce compte (@userinfobot pour l'obtenir)
TELEGRAM_CHAT_ID=

# --- Gemini ---
# Clé API : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Profil candidat (injecté dans les prompts) ---
CANDIDATE_NAME=
CANDIDATE_PROFILE=élève ingénieur informatique, alternance 2 ans
CANDIDATE_STACK=Java, JavaScript, Python, Flutter, Spring Boot, Docker
CANDIDATE_PITCH=

# --- Chemins ---
CVS_DIR=/opt/alternance-agent/cvs
LOG_FILE=/var/log/alternance-agent.log

# --- France Travail (scraper uniquement) ---
# https://francetravail.io/data/api/offres-emploi — scope api_offresdemploiv2 o2dsoffre
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
